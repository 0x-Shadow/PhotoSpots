<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the in-app updater is allowed to expose through FileProvider. Only
     the app's own scratch directories are shared, never user files. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="cache"
        path="." />
    <files-path
        name="files"
        path="." />
    <external-cache-path
        name="external_cache"
        path="." />
</paths>